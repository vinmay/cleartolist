# Copy to .env (never commit it) or set these in your process manager / the Render dashboard.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Render web service (demo/server.py) ---
CTL_UPLOADS_ENABLED=0                # kill switch: 1 to accept photo scans
CTL_INVITE_CODES=change-me-code-1,change-me-code-2   # comma-separated, 6+ characters each
CTL_WORKER_SECRET=<long-random-shared-secret>        # same value on the worker
CTL_ADMIN_SECRET=<different-long-random-secret>      # kill switch, signup export, /admin/stats password
CTL_PUBLIC_DAILY_SCANS=200           # free photo scans per day without a code, across all visitors
# DATABASE_URL is set by render.yaml from the cleartolist-db Postgres (invite requests, daily usage totals)
CTL_DEMO_DB=/tmp/demo.db
CTL_DEMO_DB_URL=https://github.com/<owner>/<repo>/releases/download/data-latest/demo.db

# --- GPU worker (worker/worker.py) ---
CTL_SERVER_URL=https://<your-service>.onrender.com   # https origin only, no path
CTL_WORKER_SECRET=<long-random-shared-secret>
